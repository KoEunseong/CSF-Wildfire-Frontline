# Model weights (download via HuggingFace)
models/*/
!models/.gitkeep

# CLIP feature cache
clip_cache/*/
!clip_cache/.gitkeep

# Training / fine-tuning outputs
train_runs/
finetune_runs/

# Inference & evaluation outputs
outputs/*/
!outputs/.gitkeep
Inference_Result/
evaluate/

# Dataset (image files not tracked — structure and README are)
Dataset/**/*.png
Dataset/**/*.jpg
Dataset/**/*.jpeg
Dataset/**/*.bmp
Dataset/**/*.tif
Dataset/**/*.tiff
!Dataset/README.md
!Dataset/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# IDE
.cursor/
.vscode/
.idea/
